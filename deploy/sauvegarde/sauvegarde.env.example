# =============================================================================
# Réglages des sauvegardes. Copier vers /srv/mobile-empire/shared/sauvegarde.env
# puis : chmod 600 /srv/mobile-empire/shared/sauvegarde.env
# Ce fichier contient des SECRETS : jamais dans git.
# =============================================================================

# Connexion à la base Supabase : bouton « Connect » en haut du tableau de bord Supabase
# → « Session pooler » → URI. Remplacez [YOUR-PASSWORD] par le mot de passe de la base
# (Project Settings → Database → Reset database password si vous ne l'avez plus).
DATABASE_URL=postgresql://postgres.<REF>:<MOT-DE-PASSE>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# Photos : mêmes valeurs que le site (NEXT_PUBLIC_SUPABASE_URL et clé secrète)
SUPABASE_URL=https://<REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Où ranger les sauvegardes, et combien en garder
BACKUP_DIR=/srv/mobile-empire/sauvegardes
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# Chiffrement (AES-256) : fichier contenant une phrase secrète longue. FORTEMENT conseillé
# (noms, téléphones, adresses des clients). Conservez une copie de cette phrase AILLEURS
# que sur le serveur (gestionnaire de mots de passe) : sans elle, aucune restauration.
#   openssl rand -base64 32 > /srv/mobile-empire/shared/sauvegarde.phrase && chmod 600 /srv/mobile-empire/shared/sauvegarde.phrase
PASSPHRASE_FILE=/srv/mobile-empire/shared/sauvegarde.phrase

# Copie hors du serveur (conseillée) : destination rclone, ex. « gdrive:mobile-empire »
# (Google Drive), « b2:mon-seau » (Backblaze). Vide = copie locale seulement.
# Exige PASSPHRASE_FILE (jamais de données personnelles en clair hors du serveur).
RCLONE_DESTINATION=
