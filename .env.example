# =============================================================================
# Variables d'environnement · copier ce fichier en .env.local et le remplir.
# .env.local n'est JAMAIS commité (voir .gitignore).
# Valeurs : Supabase → Project Settings → API (ou « API Keys »).
# =============================================================================

# URL du projet, ex. https://abcdefghijklm.supabase.co
# Publique : visible dans le navigateur, c'est normal.
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique : « anon public » (eyJ…) ou « publishable » (sb_publishable_…).
# Publique : elle ne donne que les droits autorisés par la Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé SECRÈTE : « service_role » (eyJ…) ou « secret » (sb_secret_…).
# Contourne la Row Level Security : utilisée UNIQUEMENT côté serveur pour
# enregistrer les commandes. Ne JAMAIS la préfixer NEXT_PUBLIC_, ne jamais la
# partager ni la coller dans du code. À renseigner aussi chez l'hébergeur
# (Vercel → Settings → Environment Variables).
SUPABASE_SERVICE_ROLE_KEY=

# Meta Pixel (publicités Facebook / Instagram) : identifiant du pixel, chiffres
# seuls (Meta Events Manager → Sources de données). Facultatif : vide = pixel
# désactivé, aucun script Facebook chargé. Public (visible dans le navigateur).
# Intégré à la compilation : redéployer après l'avoir changé.
NEXT_PUBLIC_META_PIXEL_ID=

# Adresse publique du site (production), pour les liens envoyés par e-mail et le retour de Google.
# Ex. https://www.mobile-empire.ml (sans / final). Vide en local : l'adresse de la requête est utilisée.
NEXT_PUBLIC_SITE_URL=
